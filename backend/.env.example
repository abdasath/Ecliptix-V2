# ⚠️ REQUIRED — the server refuses to start without this.
# Set a long random string (e.g. `openssl rand -hex 32`). Never reuse defaults.
JWT_SECRET=

# ── MongoDB ──
MONGODB_URI=mongodb://127.0.0.1:27017/gaming-platform

# ── Redis (optional — app degrades gracefully without it) ──
REDIS_URL=redis://localhost:6379

# ── Google OAuth ──
GOOGLE_CLIENT_ID=

# ── Razorpay (test keys) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── AI: Gemini (embeddings) + Groq (generation) ──
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your-groq-api-key

# ── Server ──
PORT=5000
